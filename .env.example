# Project Awaaz - Environment Configuration Template

# Google Gemini API Key (Optional for live Gemini 2.5 Flash reasoning)
GEMINI_API_KEY=

# Local Ollama Inference Server URL (Optional for local models)
OLLAMA_BASE_URL=http://localhost:11434

# Execution Engine Mode (Options: sovereign, gemini, ollama)
# Default: sovereign (100% deterministic, zero-network, air-gapped reliable)
AWAAZ_LLM_MODE=sovereign

# Vector Embedding Engine Mode (Options: hybrid, transformer, sovereign)
# Default: hybrid (combines dense neural semantics with sovereign hash projection fallback)
AWAAZ_EMBEDDING_MODE=hybrid
